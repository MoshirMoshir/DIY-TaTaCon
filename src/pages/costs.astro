---
import BaseLayout from "../layouts/BaseLayout.astro";

const bigTataCon = [
  { item: '1/2" 24"x48" Panel of Wood', cost: 25.90 },
  { item: "Leonardo Arduino", cost: 24.99 },
  { item: "Dupont Wires", cost: 6.98 },
  { item: "Piezo Sensors", cost: 8.99 },
  { item: '1/4"-20tpi 2.5" Flat Head Machine Screws', cost: 5.52 },
  { item: "Micro USB to USB cable", cost: 6.99 },
  { item: '1/4" Nuts', cost: 8.98 },
  { item: "Rubber Washers", cost: 8.99 },
  { item: '1/8" 12"x36" Gum Rubber', cost: 23.75 },
];

const smallTataCon = [
  { item: '1/4" 2\'x2\' Panel of Plywood', cost: 9.56 },
  { item: "Arduino Micro (with Headers)", cost: 23.93 },
  { item: "Dupont Wires", cost: 6.98 },
  { item: "Piezo Sensors", cost: 8.99 },
  { item: "Micro USB to USB cable", cost: 6.99 },
  { item: '1/4"-20tpi 2" Flat Head Machine Screws', cost: 4.57 },
  { item: '1/4" Nuts', cost: 6.77 },
  { item: "Rubber Washers", cost: 8.99 },
  { item: '1/4" 12"x12" Gum Rubber', cost: 15.19 },
  { item: "Laptop Stand", cost: 9.99 },
];

const optionalMaterials = [
  { item: "Electrical Tape", cost: 6.98 },
  { item: "Epoxy Glue (any glue for wood + rubber)", cost: 21.98 },
  { item: "Thread Locker", cost: 7.98 },
  { item: "Solder (Lead Free)", cost: 7.99 },
];

const tools = [
  { item: "Wire Strippers", cost: 8.19, type: "Purchase" as const },
  { item: "Soldering Tool", cost: 39.99, type: "Purchase" as const },
  { item: "Jigsaw", cost: 17, type: "Rental" as const },
  { item: "Drill", cost: 16, type: "Rental" as const },
];

function sum(items: { cost: number }[]) {
  return items.reduce((acc, i) => acc + i.cost, 0);
}

function fmt(n: number) {
  return `$${n.toFixed(2)}`;
}
---

<BaseLayout
  title="Material Costs | DIY TaTaCon"
  description="Complete cost breakdown for building a DIY TaTaCon drum controller."
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <h1 class="text-4xl font-bold tracking-tight text-ctp-text">
      Material Costs
    </h1>
    <p class="mt-3 text-ctp-subtext0">
      Everything you'll need to buy and approximate costs. Prices may vary by region and supplier.
    </p>

    <!-- Big TaTaCon -->
    <section class="mt-12">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-ctp-text">Big TaTaCon</h2>
        <span class="rounded-full bg-ctp-peach/15 px-4 py-1 text-sm font-semibold text-ctp-peach">
          ~{fmt(sum(bigTataCon))}
        </span>
      </div>
      <div class="mt-4 overflow-hidden rounded-xl border border-ctp-surface0">
        <table class="w-full">
          <thead>
            <tr class="border-b border-ctp-surface0 bg-ctp-mantle">
              <th class="px-4 py-3 text-left text-sm font-medium text-ctp-subtext0">Item</th>
              <th class="px-4 py-3 text-right text-sm font-medium text-ctp-subtext0">Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ctp-surface0">
            {bigTataCon.map((item) => (
              <tr class="transition-colors hover:bg-ctp-surface0/50">
                <td class="px-4 py-3 text-sm text-ctp-text">{item.item}</td>
                <td class="px-4 py-3 text-right text-sm text-ctp-subtext1">{fmt(item.cost)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-ctp-surface1 bg-ctp-mantle">
              <td class="px-4 py-3 text-sm font-semibold text-ctp-text">Total</td>
              <td class="px-4 py-3 text-right text-sm font-bold text-ctp-peach">~{fmt(sum(bigTataCon))}</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>

    <!-- Small TaTaCon -->
    <section class="mt-12">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-ctp-text">Small TaTaCon</h2>
        <span class="rounded-full bg-ctp-green/15 px-4 py-1 text-sm font-semibold text-ctp-green">
          ~{fmt(sum(smallTataCon))}
        </span>
      </div>
      <div class="mt-4 overflow-hidden rounded-xl border border-ctp-surface0">
        <table class="w-full">
          <thead>
            <tr class="border-b border-ctp-surface0 bg-ctp-mantle">
              <th class="px-4 py-3 text-left text-sm font-medium text-ctp-subtext0">Item</th>
              <th class="px-4 py-3 text-right text-sm font-medium text-ctp-subtext0">Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ctp-surface0">
            {smallTataCon.map((item) => (
              <tr class="transition-colors hover:bg-ctp-surface0/50">
                <td class="px-4 py-3 text-sm text-ctp-text">{item.item}</td>
                <td class="px-4 py-3 text-right text-sm text-ctp-subtext1">{fmt(item.cost)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-ctp-surface1 bg-ctp-mantle">
              <td class="px-4 py-3 text-sm font-semibold text-ctp-text">Total</td>
              <td class="px-4 py-3 text-right text-sm font-bold text-ctp-green">~{fmt(sum(smallTataCon))}</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>

    <!-- Optional Materials -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-ctp-text">Optional Materials</h2>
      <div class="mt-4 overflow-hidden rounded-xl border border-ctp-surface0">
        <table class="w-full">
          <tbody class="divide-y divide-ctp-surface0">
            {optionalMaterials.map((item) => (
              <tr class="transition-colors hover:bg-ctp-surface0/50">
                <td class="px-4 py-3 text-sm text-ctp-text">{item.item}</td>
                <td class="px-4 py-3 text-right text-sm text-ctp-subtext1">~{fmt(item.cost)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Tools -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-ctp-text">Tools</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-ctp-surface0 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ctp-overlay0">Purchase</h3>
          <ul class="mt-3 space-y-2">
            {tools.filter(t => t.type === "Purchase").map((item) => (
              <li class="flex items-center justify-between text-sm">
                <span class="text-ctp-text">{item.item}</span>
                <span class="text-ctp-subtext1">~{fmt(item.cost)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-ctp-surface0 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ctp-overlay0">Rentals</h3>
          <ul class="mt-3 space-y-2">
            {tools.filter(t => t.type === "Rental").map((item) => (
              <li class="flex items-center justify-between text-sm">
                <span class="text-ctp-text">{item.item}</span>
                <span class="text-ctp-subtext1">~{fmt(item.cost)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
