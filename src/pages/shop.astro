---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Shop | DIY TaTaCon"
  description="Purchase a pre-built TaTaCon drum controller. Coming soon."
>
  <div class="flex flex-1 items-center justify-center px-4 py-20">
    <div class="text-center">
      <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-ctp-surface0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-ctp-mauve" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-ctp-text">Shop Coming Soon</h1>
      <p class="mx-auto mt-3 max-w-md text-ctp-subtext0">
        Don't want to build it yourself? I'll be offering pre-built TaTaCons for purchase soon. Stay tuned!
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href="/guide/"
          class="inline-flex items-center gap-2 rounded-full bg-ctp-mauve px-5 py-2.5 text-sm font-semibold text-ctp-base transition-all hover:scale-105"
        >
          Build Your Own
        </a>
        <a
          href="https://github.com/MoshirMoshir/DIY-TaTaCon"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-ctp-surface1 px-5 py-2.5 text-sm font-medium text-ctp-text transition-all hover:border-ctp-surface2 hover:bg-ctp-surface0"
        >
          Follow on GitHub
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
