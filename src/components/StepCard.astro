---
import { Image } from "astro:assets";

interface Props {
  stepNumber: number;
  title: string;
  description: string;
  href: string;
  image: ImageMetadata;
}

const { stepNumber, title, description, href, image } = Astro.props;
---

<a
  href={href}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-ctp-surface0 bg-ctp-mantle transition-all duration-300 hover:scale-[1.02] hover:border-ctp-surface1 hover:shadow-lg hover:shadow-ctp-crust/50"
>
  <!-- Image -->
  <div class="relative aspect-video overflow-hidden">
    <Image
      src={image}
      alt={title}
      widths={[300, 500]}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ctp-mantle/60 to-transparent"></div>
    <!-- Step badge -->
    <div class="absolute top-3 left-3 flex h-8 w-8 items-center justify-center rounded-full bg-ctp-peach text-sm font-bold text-ctp-base">
      {stepNumber}
    </div>
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-base font-semibold text-ctp-text group-hover:text-ctp-mauve transition-colors duration-200">
      {title}
    </h3>
    <p class="mt-1 text-sm text-ctp-subtext0 line-clamp-2">
      {description}
    </p>
  </div>
</a>
