---
interface StepLink {
  title: string;
  href: string;
}

interface Props {
  prev?: StepLink;
  next?: StepLink;
}

const { prev, next } = Astro.props;
---

<nav class="mt-12 flex items-stretch gap-4 border-t border-ctp-surface0 pt-8" aria-label="Guide navigation">
  {prev ? (
    <a
      href={prev.href}
      class="group flex flex-1 items-center gap-3 rounded-xl border border-ctp-surface0 bg-ctp-mantle p-4 transition-all duration-200 hover:border-ctp-surface1 hover:bg-ctp-surface0"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-ctp-overlay0 transition-transform duration-200 group-hover:-translate-x-1 group-hover:text-ctp-mauve" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12" />
        <polyline points="12 19 5 12 12 5" />
      </svg>
      <div class="min-w-0">
        <div class="text-xs text-ctp-overlay0">Previous</div>
        <div class="truncate text-sm font-medium text-ctp-text">{prev.title}</div>
      </div>
    </a>
  ) : (
    <div class="flex-1" />
  )}

  {next ? (
    <a
      href={next.href}
      class="group flex flex-1 items-center justify-end gap-3 rounded-xl border border-ctp-surface0 bg-ctp-mantle p-4 text-right transition-all duration-200 hover:border-ctp-surface1 hover:bg-ctp-surface0"
    >
      <div class="min-w-0">
        <div class="text-xs text-ctp-overlay0">Next</div>
        <div class="truncate text-sm font-medium text-ctp-text">{next.title}</div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-ctp-overlay0 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-ctp-mauve" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    </a>
  ) : (
    <div class="flex-1" />
  )}
</nav>
