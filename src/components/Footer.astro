---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-ctp-surface0 bg-ctp-mantle">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="flex items-center gap-2 text-sm text-ctp-subtext0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ctp-peach" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" />
          <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="2" />
          <circle cx="12" cy="12" r="1.5" />
        </svg>
        <span>&copy; {currentYear} DIY TaTaCon by Moshir</span>
      </div>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/MoshirMoshir/DIY-TaTaCon"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-ctp-subtext0 transition-colors hover:text-ctp-text"
        >
          GitHub
        </a>
        <a
          href="https://github.com/MoshirMoshir/DIY-TaTaCon/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-ctp-subtext0 transition-colors hover:text-ctp-text"
        >
          Report Issue
        </a>
      </div>
    </div>
  </div>
</footer>
