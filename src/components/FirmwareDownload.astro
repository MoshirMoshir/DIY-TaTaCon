---
const files = [
  { name: "taiko_controller.ino", size: "2.8 KB", desc: "Main sketch" },
  { name: "AnalogReadNow.cpp", size: "2.2 KB", desc: "Fast ADC reads" },
  { name: "AnalogReadNow.h", size: "0.2 KB", desc: "ADC header" },
  { name: "HIDReportData.h", size: "6.7 KB", desc: "HID constants" },
  { name: "Joystick.cpp", size: "3.0 KB", desc: "Switch controller" },
  { name: "Joystick.h", size: "1.7 KB", desc: "Joystick header" },
];
---

<div class="rounded-xl border border-ctp-surface0 bg-ctp-mantle p-5">
  <h3 class="flex items-center gap-2 text-lg font-semibold text-ctp-text">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ctp-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="7 10 12 15 17 10" />
      <line x1="12" y1="15" x2="12" y2="3" />
    </svg>
    Firmware Files
  </h3>
  <p class="mt-1 text-sm text-ctp-subtext0">
    Download all files and place them in the same folder before uploading to your Arduino.
  </p>
  <div class="mt-4 divide-y divide-ctp-surface0">
    {files.map((file) => (
      <a
        href={`/firmware/${file.name}`}
        download
        class="flex items-center justify-between py-2.5 text-sm transition-colors hover:text-ctp-blue"
      >
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-ctp-overlay0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
            <polyline points="13 2 13 9 20 9" />
          </svg>
          <span class="font-medium text-ctp-text">{file.name}</span>
          <span class="text-ctp-overlay0">{file.desc}</span>
        </div>
        <span class="text-xs text-ctp-overlay0">{file.size}</span>
      </a>
    ))}
  </div>
</div>
